APP_NAME=IncuBrix PS1 Music Engine
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=./data/jobs.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JOB_SIMULATION_STEP_SECONDS=0.35
MAX_PROMPT_LENGTH=1000
MIN_DURATION_SECONDS=5
MAX_DURATION_SECONDS=300
DEFAULT_DURATION_SECONDS=45

# LLM provider selection:
# mock              = deterministic local fallback; no API key required
# openai            = OpenAI API
# huggingface       = Hugging Face Inference Providers
# ollama            = local Ollama server
# openai_compatible = any OpenAI-compatible endpoint
# auto              = Hugging Face -> OpenAI -> Ollama -> mock
LLM_PROVIDER=auto

# OpenAI-compatible provider
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Hugging Face Inference Providers
# Create a fine-grained token with "Make calls to Inference Providers" permission.
HF_BASE_URL=https://router.huggingface.co/v1
HF_API_KEY=
HF_MODEL=openai/gpt-oss-20b:fastest

# Local Ollama
# Set OLLAMA_ENABLED=true only after Ollama is installed and the model is pulled.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_ENABLED=false

# If all configured providers fail, use the deterministic local specification fallback.
LLM_AUTO_FALLBACK_TO_MOCK=true

# Module 3 local deterministic audio engine
AUDIO_OUTPUT_DIR=./audio/generated
AUDIO_SAMPLE_RATE=44100
AUDIO_SEED=4281097
AUDIO_PROVIDER=procedural
AUDIO_PROVIDER_FALLBACK=false
AUDIO_MODEL=facebook/musicgen-melody
AUDIO_MODEL_REVISION=main
AUDIO_MODEL_CACHE_DIR=./data/models
AUDIO_MODEL_LOCAL_FILES_ONLY=true
AUDIO_MODEL_DEVICE=cpu
AUDIO_MODEL_TIMEOUT_SECONDS=120
AUDIO_MODEL_RESEARCH_ACKNOWLEDGED=false
AUDIO_MODEL_TOKEN=

# Integration storage and bounded remote narration.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=incubrix-outputs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_URL_TTL_SECONDS=900
S3_TIMEOUT_SECONDS=5
MAX_REQUEST_BYTES=33554432
NARRATION_MAX_BYTES=33554432
NARRATION_TIMEOUT_SECONDS=20
NARRATION_MAX_REDIRECTS=3
NARRATION_ALLOW_HTTP=false
NARRATION_ALLOWED_PRIVATE_HOSTS=

# Module 5 — Audio Processing
AUDIO_PROCESSING_SAMPLE_RATE=48000
AUDIO_TARGET_LUFS=-16.0
AUDIO_LOUDNESS_TOLERANCE_LUFS=1.0
AUDIO_TRUE_PEAK_LIMIT_DBTP=-1.0
AUDIO_DURATION_TOLERANCE_SECONDS=0.1
AUDIO_FADE_IN_MS=10.0
AUDIO_FADE_OUT_MS=10.0
